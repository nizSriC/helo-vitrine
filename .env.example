# Helo — exemplo de variáveis de ambiente (valores fictícios)
# Copie para .env e preencha. NUNCA versione o .env real.

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=helo
DATABASE_URL=postgresql+asyncpg://postgres:troque_esta_senha@db:5432/helo

# Redis
REDIS_URL=redis://cache:6379/0

# Segurança / JWT
JWT_SECRET_KEY=gere_uma_chave_forte_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp (Z-API)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
